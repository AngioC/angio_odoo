<odoo>
    <record id="view_task_form2_inherit_gantt" model="ir.ui.view">
        <field name="name">project.task.form.gantt.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']" position="before">
                <field name="date_start"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="color" widget="color_picker" string="Color"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Gantt settings">
                    <group>
                        <field name="progress"/>
                        <field name="dependency_ids" widget="many2many_tags" options="{'no_create': True}" domain="[('project_id', '=', project_id), ('id', '!=', id)]"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>